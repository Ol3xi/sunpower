# Inserisci qui il webhook Make rigenerato. Non usare quello precedentemente esposto nel client.
MAKE_QUOTE_WEBHOOK_URL=

# Modalità prova: mostra la schermata finale demo senza inviare dati a Make.
# Imposta false (o rimuovi la variabile) quando collegherai il webhook reale.
QUOTE_DEMO_MODE=true

# Facoltativo: abilita l'anteprima satellitare da allegare alla richiesta.
# Inserisci un token ArcGIS Static Maps solo in .env.local, mai nel client o nel repository.
ARCGIS_STATIC_MAPS_TOKEN=
